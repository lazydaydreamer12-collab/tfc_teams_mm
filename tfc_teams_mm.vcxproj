<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{3F6B2A1E-9C4D-4E7A-B5D2-7A1C0E4F9B23}</ProjectGuid>
    <RootNamespace>tfc_teams_mm</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <!-- This plugin must be built as 32-bit (Win32) - GoldSrc/hlds is a
         32-bit engine, there is no x64 target. -->
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <!-- Follow whichever toolset the installed Visual Studio provides.
         Microsoft.Cpp.Default.props (imported above) sets
         $(DefaultPlatformToolset) to that - v145 on this machine at the
         time of writing. Pinning a literal version here is what broke the
         build once already: a checked-in "v142" met a machine that had no
         VS2019 build tools and MSBuild refused to start. The literal below
         is only a fallback for the case where the property is somehow
         empty. -->
    <PlatformToolset Condition="'$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)'==''">v145</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />

  <!-- Output named to match the _mm.dll convention this server's
       plugins.ini already uses for other plugins (foxbot, amxmodx). -->
  <PropertyGroup>
    <TargetName>tfc_teams_mm</TargetName>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /MT: static CRT, so the plugin doesn't need a matching vcredist
           installed on the server. Matches convention for GoldSrc/hlds
           plugin builds. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <AdditionalIncludeDirectories>.;..\hlsdk\common;..\hlsdk\dlls;..\hlsdk\engine;..\hlsdk\pm_shared;..\metamod;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Put only the .pdb's file name in the DLL, not the full path it was
           built in (that path is readable by anyone who downloads the DLL). -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <!-- Forces GiveFnptrsToDll to export undecorated - see
           tfc_teams_mm.def for why this is required. -->
      <ModuleDefinitionFile>tfc_teams_mm.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_DEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <AdditionalIncludeDirectories>.;..\hlsdk\common;..\hlsdk\dlls;..\hlsdk\engine;..\hlsdk\pm_shared;..\metamod;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Put only the .pdb's file name in the DLL, not the full path it was
           built in (that path is readable by anyone who downloads the DLL). -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <!-- Forces GiveFnptrsToDll to export undecorated - see
           tfc_teams_mm.def for why this is required. -->
      <ModuleDefinitionFile>tfc_teams_mm.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="dllapi.cpp" />
    <ClCompile Include="h_export.cpp" />
    <ClCompile Include="meta_api.cpp" />
    <ClCompile Include="sdk_util.cpp" />
    <ClCompile Include="tt_balance.cpp" />
    <ClCompile Include="tt_config.cpp" />
    <ClCompile Include="tt_engine.cpp" />
    <ClCompile Include="tt_map.cpp" />
    <ClCompile Include="tt_players.cpp" />
    <ClCompile Include="tt_scramble.cpp" />
    <ClCompile Include="tt_stats.cpp" />
    <ClCompile Include="tt_crypto.cpp" />
    <ClCompile Include="tt_secret.cpp" />
    <ClCompile Include="tt_net.cpp" />
    <ClCompile Include="tt_names.cpp" />
    <ClCompile Include="tt_feed.cpp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tfc_teams_mm.def" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="sdk_compat.h" />
    <ClInclude Include="tt_common.h" />
    <ClInclude Include="tt_stats.h" />
    <ClInclude Include="tt_net.h" />
    <ClInclude Include="tt_crypto.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

  <!-- Copy the freshly linked DLL to where metamod actually loads it from.
       Without this the build succeeds, bin\Debug gets a new binary, and the
       game keeps running the previous one - which looks exactly like "the fix
       didn't work" and has cost several live test runs.

       Retries exist because Windows will not overwrite a DLL that is open:
       if the server is still running when you build, the copy fails. That
       failure is deliberately NOT swallowed - a build that cannot deploy
       should stop and say so, rather than leave a stale DLL in place while
       reporting success. If it does stop here, shut the server down and
       build again. -->
  <Target Name="DeployToAddons" AfterTargets="Build">
    <MakeDir Directories="$(SolutionDir)..\..\..\tfc_teams_mm\" />
    <PropertyGroup>
      <WCDeployDir>$(SolutionDir)..\..\..\tfc_teams_mm\</WCDeployDir>
    </PropertyGroup>
    <Message Importance="high" Text="Deploying $(TargetFileName) -&gt; $(WCDeployDir)tfc_teams_mm_mm.dll" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(WCDeployDir)tfc_teams_mm_mm.dll"
          Retries="3" RetryDelayMilliseconds="700" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFiles="$(WCDeployDir)tfc_teams_mm_mm.pdb"
          Retries="3" RetryDelayMilliseconds="700"
          ContinueOnError="true" />
    <Message Importance="high" Text="Deployed OK - the running game will pick this up on its next load." />
  </Target>
</Project>
